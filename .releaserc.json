{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/exec", { "prepareCmd": ".github/scripts/build-cli.sh ${nextRelease.version}" }],
    ["@semantic-release/git", { "assets": ["CHANGELOG.md", "cli/Cargo.toml", "cli/Cargo.lock"] }],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "dist/*.tar.gz" }],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
